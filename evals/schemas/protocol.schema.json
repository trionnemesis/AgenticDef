{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LiveProtocol",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "protocol_id", "decision", "operator", "purpose", "provider", "set", "k", "caps",
               "prices", "input_overhead_tokens", "data_scope", "analysis"],
  "properties": {
    "protocol_version": {"const": "1"},
    "protocol_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "decision": {"type": "string", "minLength": 1, "maxLength": 300},
    "operator": {"type": "string", "minLength": 1, "maxLength": 100},
    "purpose": {"enum": ["smoke", "measurement"]},
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "anthropic_version", "model", "max_tokens", "thinking", "effort", "fallbacks",
                   "retries"],
      "properties": {
        "endpoint": {"type": "string", "pattern": "^https://\\S+$", "maxLength": 200},
        "anthropic_version": {"$ref": "#/$defs/date"},
        "model": {"type": "string", "pattern": "^claude-[a-z0-9-]{1,60}$"},
        "max_tokens": {"type": "integer", "minimum": 1, "maximum": 128000},
        "thinking": {"enum": ["api_default"]},
        "effort": {"enum": ["api_default"]},
        "fallbacks": {"const": "none"},
        "retries": {"const": 0}
      }
    },
    "set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator_version", "oracle_version", "generator_seed", "holdout_fraction", "split", "families",
                   "cases"],
      "properties": {
        "generator_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "oracle_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "generator_seed": {"type": "integer", "minimum": 0},
        "holdout_fraction": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "split": {"enum": ["dev", "holdout"]},
        "families": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true,
                     "items": {"type": "string", "pattern": "^f-[0-9a-f]{10}$"}},
        "cases": {"type": "integer", "minimum": 1}
      }
    },
    "k": {"type": "integer", "minimum": 1, "maximum": 10},
    "caps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_cost_usd", "max_model_calls"],
      "properties": {
        "max_cost_usd": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000},
        "max_model_calls": {"type": "integer", "minimum": 1}
      }
    },
    "prices": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_usd_per_mtok", "output_usd_per_mtok", "cache_write_usd_per_mtok", "cache_read_usd_per_mtok",
                   "source", "as_of"],
      "properties": {
        "input_usd_per_mtok": {"$ref": "#/$defs/price"},
        "output_usd_per_mtok": {"$ref": "#/$defs/price"},
        "cache_write_usd_per_mtok": {"$ref": "#/$defs/price"},
        "cache_read_usd_per_mtok": {"$ref": "#/$defs/price"},
        "source": {"type": "string", "minLength": 1, "maxLength": 400},
        "as_of": {"$ref": "#/$defs/date"}
      }
    },
    "input_overhead_tokens": {"type": "integer", "minimum": 0, "maximum": 4096},
    "data_scope": {"type": "string", "minLength": 1, "maxLength": 600},
    "analysis": {"type": "string", "minLength": 1, "maxLength": 600}
  },
  "$defs": {
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "price": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000}
  }
}
