{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvaluationCase",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "seed", "description", "event", "policy", "evidence"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "seed": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"},
    "description": {"type": "string", "maxLength": 512},
    "event": {"type": "object"},
    "policy": {"type": "object"},
    "evidence": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool", "arguments", "observed_at", "data"],
        "properties": {
          "tool": {"type": "string", "minLength": 1, "maxLength": 64},
          "arguments": {"type": "object"},
          "observed_at": {"type": "string", "format": "date-time"},
          "data": {"type": "object"}
        }
      }
    }
  }
}
