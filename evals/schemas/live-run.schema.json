{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LiveRun",
  "type": "object",
  "additionalProperties": false,
  "required": ["live_run_version", "protocol_id", "protocol_digest", "protocol", "repo_sha", "status", "stop", "ledger",
               "metrics"],
  "properties": {
    "live_run_version": {"const": "1"},
    "protocol_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "protocol_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "protocol": {"type": "object"},
    "repo_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "status": {"enum": ["completed", "stopped"]},
    "stop": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/stop"}]},
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calls", "input_tokens", "output_tokens", "cache_write_tokens", "cache_read_tokens", "cost_usd",
                   "worst_case_charged", "http_statuses"],
      "properties": {
        "calls": {"$ref": "#/$defs/count"},
        "input_tokens": {"$ref": "#/$defs/count"},
        "output_tokens": {"$ref": "#/$defs/count"},
        "cache_write_tokens": {"$ref": "#/$defs/count"},
        "cache_read_tokens": {"$ref": "#/$defs/count"},
        "cost_usd": {"type": "number", "minimum": 0},
        "worst_case_charged": {"$ref": "#/$defs/count"},
        "http_statuses": {"type": "object", "propertyNames": {"pattern": "^[1-5][0-9]{2}$"},
                          "additionalProperties": {"type": "integer", "minimum": 1}}
      }
    },
    "metrics": {"type": ["object", "null"]}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "completed"}}},
     "then": {"properties": {"stop": {"type": "null"}, "metrics": {"type": "object"}}}},
    {"if": {"properties": {"status": {"const": "stopped"}}},
     "then": {"properties": {"stop": {"type": "object"}, "metrics": {"type": "null"}}}}
  ],
  "$defs": {
    "count": {"type": "integer", "minimum": 0},
    "stop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition", "detail"],
      "properties": {
        "condition": {"enum": ["request_mismatch", "max_model_calls", "max_cost_usd", "transport_error", "http_status",
                               "response_too_large", "usage_missing", "served_model_mismatch",
                               "worst_case_exceeded"]},
        "detail": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    }
  }
}
